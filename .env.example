# Copy to .env for local dev. Do not commit .env.
NEWSAPI_KEY=your_newsapi_key_here

# Optional. If set, Claude curates the day's stories, writes a "why it
# matters" gloss per pick, and a 2-3 sentence daily brief.
ANTHROPIC_API_KEY=sk-ant-...

# Override model. Defaults to claude-opus-4-5.
# Use claude-haiku-4-5 for ~15x lower cost.
# CLAUDE_MODEL=claude-opus-4-5
